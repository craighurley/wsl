Host *
    AddKeysToAgent          yes
    ConnectTimeout          5
    ControlMaster           auto
    ControlPath             ~/.ssh/%C
    ControlPersist          30
    ServerAliveInterval     60
    TCPKeepAlive            yes
    IdentitiesOnly          yes
    ForwardAgent            no

Host github.com
    HostName                ssh.github.com
    IdentitiesOnly          yes
    IdentityFile            ~/.ssh/%u
    PasswordAuthentication  no
    Port                    443
